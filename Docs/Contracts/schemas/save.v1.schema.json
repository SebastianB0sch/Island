{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://duelacademy.local/contracts/save.v1.schema.json",
  "title": "Duel Academy save payload v1",
  "description": "Authoritative save payload (JSON). A02's runtime writes version, slot, slot_name, saved_at, profile, calendar, settings, flags, counters, emails and meta. Lane providers add root sections (inventory, decks, story, exams). calendar.month_index is the school index 0..11 (October=0); calendar.month is the real month 1..12. Add fields through a provider or a version bump, never ad-hoc keys.",
  "type": "object",
  "required": [
    "version",
    "slot",
    "profile",
    "calendar",
    "flags",
    "counters",
    "emails",
    "settings"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "slot": { "type": "integer", "minimum": 0, "maximum": 3 },
    "slot_name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "saved_at": { "type": "string" },
    "profile": {
      "type": "object",
      "required": ["name", "dorm", "title", "dp", "gender"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 16 },
        "dorm": { "type": "string", "enum": ["Slifer", "Ra", "Obelisk", "White"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 64 },
        "dp": { "type": "integer", "minimum": 0 },
        "gender": { "type": "string", "enum": ["male", "female", "unspecified"] },
        "playtime_seconds": { "type": "integer", "minimum": 0 },
        "temporary_title": { "type": "string" },
        "temporary_title_days": { "type": "integer", "minimum": 0 },
        "initialized": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "calendar": {
      "type": "object",
      "required": ["year", "day", "period"],
      "properties": {
        "year": { "type": "integer", "minimum": 1, "maximum": 3 },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "month_index": { "type": "integer", "minimum": 0, "maximum": 11 },
        "day": { "type": "integer", "minimum": 1, "maximum": 31 },
        "period": { "type": "string", "enum": ["AM", "PM", "Night"] },
        "weekday": {
          "type": "string",
          "enum": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
        },
        "hour": { "type": "integer", "minimum": 0, "maximum": 23 }
      },
      "anyOf": [
        { "required": ["month"] },
        { "required": ["month_index"] }
      ],
      "additionalProperties": false
    },
    "flags": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "counters": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "inventory": {
      "oneOf": [
        { "$ref": "#/definitions/inventoryFlat" },
        { "$ref": "#/definitions/inventorySection" }
      ]
    },
    "decks": {
      "oneOf": [
        {
          "type": "array",
          "items": { "$ref": "#/definitions/saveDeck" }
        },
        {
          "type": "object",
          "required": ["decks"],
          "properties": {
            "version": { "type": "integer", "minimum": 1 },
            "decks": { "type": "array", "items": { "$ref": "#/definitions/saveDeck" } }
          },
          "additionalProperties": true
        }
      ]
    },
    "events": {
      "type": "object",
      "patternProperties": {
        "^[A-Z]{1,3}[0-9]{2}[a-z]?$": {
          "type": "string",
          "enum": ["available", "active", "complete", "failed", "skipped"]
        }
      },
      "additionalProperties": false
    },
    "exams": {
      "type": "array",
      "items": { "$ref": "#/definitions/examResult" }
    },
    "emails": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/emailState" }
    },
    "settings": {
      "type": "object",
      "properties": {
        "animation_speed": { "type": "integer", "minimum": 0, "maximum": 3 },
        "confirm_activation": { "type": "boolean" },
        "text_speed": { "type": "integer", "minimum": 0, "maximum": 3 },
        "master_volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "music_volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "sfx_volume": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "story": {
      "type": ["object", "null"],
      "properties": {
        "event_id": { "type": "string", "pattern": "^[A-Z]{1,3}[0-9]{2}[a-z]?$" },
        "scene_id": { "type": "string", "minLength": 1 },
        "command_index": { "type": "integer", "minimum": 0 },
        "pending_choice": { "type": ["string", "null"] },
        "queue": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["event_id", "scene_id", "command_index"],
      "additionalProperties": true
    },
    "meta": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "dorm": { "type": "string" },
        "dp": { "type": "integer", "minimum": 0 },
        "playtime_seconds": { "type": "number", "minimum": 0 },
        "year": { "type": "integer", "minimum": 1 },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "month_index": { "type": "integer", "minimum": 0, "maximum": 11 },
        "day": { "type": "integer", "minimum": 1, "maximum": 31 },
        "period": { "type": "string", "enum": ["AM", "PM", "Night"] },
        "saved_at": { "type": "string" },
        "build": { "type": "string" }
      },
      "additionalProperties": true
    },
    "sections": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "definitions": {
    "cardId": { "type": "integer", "minimum": 1, "maximum": 1200 },
    "inventoryFlat": {
      "type": "object",
      "patternProperties": {
        "^[1-9][0-9]{0,3}$": { "type": "integer", "minimum": 0, "maximum": 99 }
      },
      "additionalProperties": false
    },
    "inventorySection": {
      "type": "object",
      "required": ["counts"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "max_owned_copies": { "type": "integer", "minimum": 1, "maximum": 99 },
        "counts": {
          "type": "object",
          "patternProperties": {
            "^[1-9][0-9]{0,3}$": { "type": "integer", "minimum": 0, "maximum": 99 }
          },
          "additionalProperties": false
        },
        "pending_ante": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "saveDeck": {
      "type": "object",
      "required": ["id", "name", "main", "extra"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "main": {
          "type": "array",
          "minItems": 40,
          "maxItems": 60,
          "items": { "$ref": "#/definitions/cardId" }
        },
        "extra": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/definitions/cardId" }
        },
        "side": {
          "type": "array",
          "maxItems": 15,
          "items": { "$ref": "#/definitions/cardId" }
        },
        "is_default": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "examResult": {
      "type": "object",
      "required": ["month", "written", "timed", "practical", "result"],
      "properties": {
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "written": { "type": "integer", "minimum": 0, "maximum": 10 },
        "timed": { "type": "boolean" },
        "practical": { "type": "integer", "minimum": 0, "maximum": 500 },
        "result": { "type": "string", "enum": ["pass", "fail", "pending", "exempt"] }
      },
      "additionalProperties": true
    },
    "emailState": {
      "type": "object",
      "required": ["unlocked", "read"],
      "properties": {
        "unlocked": { "type": "boolean" },
        "read": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "requests": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    }
  }
}
