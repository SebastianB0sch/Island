{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://duelacademy.local/contracts/exams.schema.json",
  "title": "Monthly exam definitions",
  "description": "12 exam cycles. month_index 1 = October (the first school month); calendar_month is the real month used by the save calendar.",
  "oneOf": [
    {
      "type": "array",
      "items": { "$ref": "#/definitions/exam" }
    },
    {
      "type": "object",
      "required": ["exams"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "exams": { "type": "array", "items": { "$ref": "#/definitions/exam" } },
        "source": { "type": "string" }
      },
      "additionalProperties": true
    }
  ],
  "definitions": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
    "practicalObjective": {
      "type": "string",
      "enum": ["battle", "spells", "traps", "damage", "fusion", "ritual", "special_summon"]
    },
    "rewards": {
      "type": "object",
      "properties": {
        "dp": { "type": "integer", "minimum": 0 },
        "title": { "type": "string" },
        "dorm": { "type": "string", "enum": ["Slifer", "Ra", "Obelisk"] },
        "cards": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 1200 }
        }
      },
      "additionalProperties": true
    },
    "exam": {
      "type": "object",
      "required": ["id", "month_index", "written", "timed", "practical", "scoring"],
      "properties": {
        "id": { "type": "string", "pattern": "^EXAM_[0-9]{2}$" },
        "month_index": { "type": "integer", "minimum": 1, "maximum": 12 },
        "calendar_month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "title": { "type": "string" },
        "written": {
          "type": "object",
          "required": ["question_ids", "max_points"],
          "properties": {
            "question_ids": {
              "type": "array",
              "minItems": 10,
              "maxItems": 10,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[QW][0-9]{3}$" }
            },
            "points_per_correct": { "type": "integer", "minimum": 1, "maximum": 100 },
            "max_points": { "type": "integer", "minimum": 1, "maximum": 500 }
          },
          "additionalProperties": true
        },
        "timed": {
          "type": "object",
          "required": ["puzzle_ids", "max_points"],
          "properties": {
            "puzzle_level": { "type": "integer", "minimum": 1, "maximum": 5 },
            "puzzle_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^P[0-9]{3}$" }
            },
            "time_limit_seconds": { "type": "integer", "minimum": 1, "maximum": 9999 },
            "max_points": { "type": "integer", "minimum": 1, "maximum": 500 }
          },
          "additionalProperties": true
        },
        "practical": {
          "type": "object",
          "required": ["opponent", "objectives", "max_points"],
          "properties": {
            "opponent": { "$ref": "#/definitions/slug" },
            "objectives": {
              "type": "array",
              "minItems": 1,
              "maxItems": 7,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/practicalObjective" }
            },
            "max_points": { "type": "integer", "minimum": 1, "maximum": 500 }
          },
          "additionalProperties": true
        },
        "scoring": {
          "type": "object",
          "required": ["written_max", "timed_max", "practical_max", "max", "pass_mark"],
          "properties": {
            "written_max": { "type": "integer", "minimum": 0, "maximum": 500 },
            "timed_max": { "type": "integer", "minimum": 0, "maximum": 500 },
            "practical_max": { "type": "integer", "minimum": 0, "maximum": 500 },
            "max": { "type": "integer", "minimum": 1, "maximum": 500 },
            "pass_mark": { "type": "integer", "minimum": 0, "maximum": 500 }
          },
          "additionalProperties": true
        },
        "rewards": {
          "type": "object",
          "properties": {
            "pass": { "$ref": "#/definitions/rewards" },
            "fail": { "$ref": "#/definitions/rewards" }
          },
          "additionalProperties": true
        },
        "source": { "type": "string", "enum": ["canon", "original", "fallback"] },
        "trace_id": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
