{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://duelacademy.local/contracts/fusions.schema.json",
  "title": "Fusion recipe table",
  "description": "Existing fusions.json uses result/materials/fusionTypes; materialsType+anyCount covers generic material recipes such as F.G.D.",
  "oneOf": [
    {
      "type": "array",
      "items": { "$ref": "#/definitions/recipe" }
    },
    {
      "type": "object",
      "required": ["fusions"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "fusions": { "type": "array", "items": { "$ref": "#/definitions/recipe" } },
        "source": { "type": "string" }
      },
      "additionalProperties": true
    }
  ],
  "definitions": {
    "cardId": { "type": "integer", "minimum": 1, "maximum": 1200 },
    "recipe": {
      "type": "object",
      "required": ["result", "name", "materials", "fusionTypes"],
      "properties": {
        "result": { "$ref": "#/definitions/cardId" },
        "name": { "type": "string", "minLength": 1 },
        "materials": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": { "$ref": "#/definitions/cardId" }
        },
        "fusionTypes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "materialsType": { "type": "string" },
        "anyCount": { "type": "integer", "minimum": 0, "maximum": 8 },
        "source": {},
        "trace_id": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
