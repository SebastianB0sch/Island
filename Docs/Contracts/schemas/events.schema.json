{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://duelacademy.local/contracts/events.schema.json",
  "title": "Story event graph",
  "description": "Canonical story events E01..E33 (+E28b). Conditions are typed predicates consumed by UDAStorySubsystem. Scene commands live in Story/scenes/*.json.",
  "oneOf": [
    {
      "type": "array",
      "items": { "$ref": "#/definitions/event" }
    },
    {
      "type": "object",
      "required": ["events"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "events": { "type": "array", "items": { "$ref": "#/definitions/event" } },
        "source": { "type": "string" }
      },
      "additionalProperties": true
    }
  ],
  "definitions": {
    "eventId": { "type": "string", "pattern": "^[A-Z]{1,3}[0-9]{2}[a-z]?$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
    "anchorId": { "type": "string", "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)*$" },
    "weekday": {
      "type": "string",
      "enum": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
    },
    "period": { "type": "string", "enum": ["AM", "PM", "Night"] },
    "dorm": { "type": "string", "enum": ["Slifer", "Ra", "Obelisk", "White"] },
    "condition": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "flag",
            "counter",
            "date",
            "weekday",
            "period",
            "event",
            "card",
            "location",
            "dorm",
            "title",
            "duel_result",
            "exam_result"
          ]
        },
        "id": { "type": "string" },
        "value": {},
        "op": { "type": "string", "enum": ["==", "!=", ">", ">=", "<", "<="] },
        "calendar_month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "integer", "minimum": 1, "maximum": 31 },
        "min_count": { "type": "integer", "minimum": 0 },
        "state": { "type": "string", "enum": ["available", "active", "complete", "failed", "skipped"] },
        "negate": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "rewardCard": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 1200 },
        {
          "type": "object",
          "required": ["card"],
          "properties": {
            "card": { "type": "integer", "minimum": 1, "maximum": 1200 },
            "count": { "type": "integer", "minimum": 1, "maximum": 3 }
          },
          "additionalProperties": true
        }
      ]
    },
    "rewardPack": {
      "oneOf": [
        { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
        {
          "type": "object",
          "required": ["pack"],
          "properties": {
            "pack": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
            "count": { "type": "integer", "minimum": 1, "maximum": 99 }
          },
          "additionalProperties": true
        }
      ]
    },
    "rewards": {
      "type": "object",
      "properties": {
        "dp": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "cards": { "type": "array", "items": { "$ref": "#/definitions/rewardCard" } },
        "packs": { "type": "array", "items": { "$ref": "#/definitions/rewardPack" } },
        "flags": { "type": "array", "items": { "$ref": "#/definitions/slug" } },
        "counters": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "title": { "type": "string" },
        "dorm": { "$ref": "#/definitions/dorm" }
      },
      "additionalProperties": true
    },
    "duel": {
      "type": "object",
      "required": ["opponent", "deck", "mode"],
      "properties": {
        "opponent": { "$ref": "#/definitions/slug" },
        "deck": { "$ref": "#/definitions/slug" },
        "mode": {
          "type": "string",
          "enum": ["story", "free", "tutorial", "exam_timed", "exam_practical", "puzzle", "ante"]
        },
        "puzzle": { "type": "string", "pattern": "^P[0-9]{3}$" },
        "ante": { "type": "boolean" },
        "on_win": { "type": "string", "enum": ["continue", "retry", "end", "fail"] },
        "on_loss": { "type": "string", "enum": ["continue", "retry", "end", "fail"] },
        "turn_limit": { "type": "integer", "minimum": 0, "maximum": 99 }
      },
      "additionalProperties": true
    },
    "choice": {
      "type": "object",
      "required": ["id", "text_key"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "text_key": { "type": "string", "minLength": 1 },
        "requires": { "type": "array", "items": { "$ref": "#/definitions/condition" } },
        "rewards": { "$ref": "#/definitions/rewards" },
        "set_flags": { "type": "array", "items": { "$ref": "#/definitions/slug" } },
        "next_event": { "$ref": "#/definitions/eventId" }
      },
      "additionalProperties": true
    },
    "event": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/definitions/eventId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "order": { "type": "integer", "minimum": 0 },
        "date": {
          "type": "object",
          "properties": {
            "calendar_month": { "type": "integer", "minimum": 1, "maximum": 12 },
            "day": { "type": "integer", "minimum": 1, "maximum": 31 },
            "weekday": { "$ref": "#/definitions/weekday" },
            "period": { "$ref": "#/definitions/period" }
          },
          "additionalProperties": true
        },
        "location": { "$ref": "#/definitions/slug" },
        "anchor": { "$ref": "#/definitions/anchorId" },
        "dorm": { "$ref": "#/definitions/dorm" },
        "priority": { "type": "integer" },
        "repeatable": { "type": "boolean" },
        "requires": { "type": "array", "items": { "$ref": "#/definitions/condition" } },
        "requires_events": {
          "type": "array",
          "items": { "$ref": "#/definitions/eventId" }
        },
        "scene": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.json$" },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "Dialogue",
                  "Choice",
                  "Camera",
                  "MoveNpc",
                  "Fade",
                  "Wait",
                  "Banner",
                  "PlaySfx",
                  "Music",
                  "Duel",
                  "Reward",
                  "SetFlag",
                  "End"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "choices": { "type": "array", "items": { "$ref": "#/definitions/choice" } },
        "duel": { "$ref": "#/definitions/duel" },
        "rewards": { "$ref": "#/definitions/rewards" },
        "on_complete": {
          "type": "object",
          "properties": {
            "flags": { "type": "array", "items": { "$ref": "#/definitions/slug" } },
            "counters": {
              "type": "object",
              "additionalProperties": { "type": "integer" }
            },
            "next_event": { "$ref": "#/definitions/eventId" }
          },
          "additionalProperties": true
        },
        "fallback": { "type": "string", "enum": ["continue", "retry", "end", "fail", "skip"] },
        "source": { "type": "string" },
        "trace_id": { "type": "string" }
      },
      "anyOf": [
        { "required": ["scene"] },
        { "required": ["commands"] }
      ],
      "additionalProperties": true
    }
  }
}
