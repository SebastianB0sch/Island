{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://duelacademy.local/contracts/opponents.schema.json",
  "title": "Duelist roster",
  "description": "Canonical opponents, their decks, evolution steps, AI profiles, schedules and request/email hooks.",
  "oneOf": [
    {
      "type": "array",
      "items": { "$ref": "#/definitions/opponent" }
    },
    {
      "type": "object",
      "required": ["opponents"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "opponents": { "type": "array", "items": { "$ref": "#/definitions/opponent" } },
        "source": { "type": "string" }
      },
      "additionalProperties": true
    }
  ],
  "definitions": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
    "dorm": { "type": "string", "enum": ["Slifer", "Ra", "Obelisk", "White"] },
    "rewards": {
      "type": "object",
      "properties": {
        "dp": { "type": "integer", "minimum": 0 },
        "cards": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 1200 }
        },
        "packs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" }
        }
      },
      "additionalProperties": true
    },
    "evolution": {
      "type": "object",
      "required": ["deck"],
      "properties": {
        "deck": { "$ref": "#/definitions/slug" },
        "after_wins": { "type": "integer", "minimum": 1 },
        "after_event": { "type": "string", "pattern": "^E[0-9]{2}[a-z]?$" },
        "flag": { "$ref": "#/definitions/slug" },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "opponent": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "character_id": { "$ref": "#/definitions/slug" },
        "title": { "type": "string" },
        "dorm": { "$ref": "#/definitions/dorm" },
        "deck": { "$ref": "#/definitions/slug" },
        "decks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/slug" }
        },
        "evolution": { "type": "array", "items": { "$ref": "#/definitions/evolution" } },
        "ai_profile": { "$ref": "#/definitions/slug" },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "schedule": { "$ref": "#/definitions/slug" },
        "event_only": { "type": "boolean" },
        "ante": { "type": "boolean" },
        "duel_request": {
          "type": "object",
          "properties": {
            "unlock_flag": { "$ref": "#/definitions/slug" },
            "email": { "$ref": "#/definitions/slug" },
            "min_wins": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "rewards": { "$ref": "#/definitions/rewards" },
        "source": { "type": "string", "enum": ["canon", "original", "fallback"] },
        "trace_id": { "type": "string" }
      },
      "anyOf": [
        { "required": ["deck"] },
        { "required": ["decks"] }
      ],
      "additionalProperties": true
    }
  }
}
