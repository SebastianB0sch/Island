{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://duelacademy.local/contracts/limitations.schema.json",
  "title": "Forbidden / limited card list",
  "description": "Canonical banlist used by deck validation. Card ids may appear in at most one bucket.",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "forbidden": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 1200 }
    },
    "limited": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 1200 }
    },
    "semi_limited": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 1200 }
    },
    "source": { "type": "string" },
    "trace_id": { "type": "string" }
  },
  "additionalProperties": true
}
