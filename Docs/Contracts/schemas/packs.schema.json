{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://duelacademy.local/contracts/packs.schema.json",
  "title": "Booster pack catalogue",
  "description": "48 canonical booster packs. v1 accepts pool: [{card,...}] and the A06 catalogue form pools: [{rarity, cards:[id,...]}]. Slots either declare count or are one entry per card slot.",
  "oneOf": [
    {
      "type": "array",
      "items": { "$ref": "#/definitions/pack" }
    },
    {
      "type": "object",
      "required": ["packs"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "packs": { "type": "array", "items": { "$ref": "#/definitions/pack" } },
        "source": { "type": "string" }
      },
      "additionalProperties": true
    }
  ],
  "definitions": {
    "cardId": { "type": "integer", "minimum": 1, "maximum": 1200 },
    "rarity": {
      "type": "string",
      "enum": [
        "common",
        "rare",
        "super_rare",
        "ultra_rare",
        "Common",
        "Rare",
        "SuperRare",
        "UltraRare",
        "SecretRare"
      ]
    },
    "poolEntry": {
      "oneOf": [
        { "$ref": "#/definitions/cardId" },
        {
          "type": "object",
          "required": ["card"],
          "properties": {
            "card": { "$ref": "#/definitions/cardId" },
            "rarity": { "$ref": "#/definitions/rarity" },
            "weight": { "type": "number", "minimum": 0 },
            "foil": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      ]
    },
    "poolGroup": {
      "type": "object",
      "required": ["cards"],
      "properties": {
        "rarity": { "$ref": "#/definitions/rarity" },
        "cards": {
          "type": "array",
          "minItems": 0,
          "items": { "$ref": "#/definitions/cardId" }
        }
      },
      "additionalProperties": true
    },
    "slot": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "rarity": { "$ref": "#/definitions/rarity" },
        "count": { "type": "integer", "minimum": 1, "maximum": 10 },
        "count_min": { "type": "integer", "minimum": 0 },
        "count_max": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "unlock": {
      "type": "object",
      "properties": {
        "school_month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "calendar_month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "event": { "type": "string", "pattern": "^[A-Z]{1,3}[0-9]{2}[a-z]?$" },
        "flag": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
        "title": { "type": "string" },
        "min_dp": { "type": "integer", "minimum": 0 },
        "dorm": { "type": "string", "enum": ["Slifer", "Ra", "Obelisk", "White"] },
        "description": { "type": "string" },
        "conditions": {
          "type": "array",
          "items": { "type": "object", "required": ["type"], "additionalProperties": true }
        }
      },
      "additionalProperties": true
    },
    "pack": {
      "type": "object",
      "required": ["id", "name", "price", "pack_size"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "category": { "type": "string", "minLength": 1, "maxLength": 64 },
        "price": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "pack_size": { "type": "integer", "minimum": 1, "maximum": 10 },
        "cards_per_pack": { "type": "integer", "minimum": 1, "maximum": 10 },
        "pool": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1200,
          "items": { "$ref": "#/definitions/poolEntry" }
        },
        "pools": {
          "type": "array",
          "minItems": 0,
          "items": { "$ref": "#/definitions/poolGroup" }
        },
        "slots": {
          "type": "array",
          "items": { "$ref": "#/definitions/slot" }
        },
        "rarity_weights": {
          "type": "object",
          "properties": {
            "common": { "type": "number", "minimum": 0, "maximum": 100 },
            "rare": { "type": "number", "minimum": 0, "maximum": 100 },
            "super_rare": { "type": "number", "minimum": 0, "maximum": 100 },
            "ultra_rare": { "type": "number", "minimum": 0, "maximum": 100 }
          },
          "additionalProperties": false
        },
        "unlock": { "$ref": "#/definitions/unlock" },
        "availability": {
          "type": "string",
          "enum": ["shop", "event", "starter", "promo", "post_game"]
        },
        "source": { "type": "string" },
        "trace_id": { "type": "string" }
      },
      "anyOf": [
        { "required": ["pool"] },
        { "required": ["pools"] }
      ],
      "additionalProperties": true
    }
  }
}
