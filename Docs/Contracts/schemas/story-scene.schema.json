{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://duelacademy.local/contracts/story-scene.schema.json",
  "title": "Serializable story command queue",
  "description": "One JSON file per scene under Content/Data/Story/scenes/. Mirrors FStoryCommand in Docs/Contracts/headers/DAStoryContract.h. Commands are replayed by A09 and may pause on Dialogue/Choice/Duel.",
  "type": "object",
  "required": ["id", "commands"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
    "event": { "type": "string", "pattern": "^E[0-9]{2}[a-z]?$" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/command" }
    },
    "source": { "type": "string" },
    "trace_id": { "type": "string" }
  },
  "additionalProperties": true,
  "definitions": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
    "commandType": {
      "type": "string",
      "enum": [
        "Dialogue",
        "Choice",
        "Camera",
        "MoveNpc",
        "Fade",
        "Wait",
        "Banner",
        "PlaySfx",
        "Music",
        "Duel",
        "Reward",
        "SetFlag",
        "End"
      ]
    },
    "choice": {
      "type": "object",
      "required": ["id", "text_key"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "text_key": { "type": "string", "minLength": 1 },
        "set_flags": { "type": "array", "items": { "$ref": "#/definitions/slug" } },
        "next": { "type": "string" }
      },
      "additionalProperties": true
    },
    "command": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "command_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "type": { "$ref": "#/definitions/commandType" },
        "speaker": { "$ref": "#/definitions/slug" },
        "portrait": { "type": "string", "minLength": 1, "maxLength": 128 },
        "text_key": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "duration": { "type": "number", "minimum": 0 },
        "skippable": { "type": "boolean" },
        "choices": { "type": "array", "items": { "$ref": "#/definitions/choice" } },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
