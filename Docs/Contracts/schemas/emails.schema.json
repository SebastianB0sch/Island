{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://duelacademy.local/contracts/emails.schema.json",
  "title": "PDA email table",
  "description": "Email contacts unlock after meeting an NPC. A message may carry a duel request, a reward or a story flag.",
  "oneOf": [
    {
      "type": "array",
      "items": { "$ref": "#/definitions/email" }
    },
    {
      "type": "object",
      "required": ["emails"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "emails": { "type": "array", "items": { "$ref": "#/definitions/email" } },
        "source": { "type": "string" }
      },
      "additionalProperties": true
    }
  ],
  "definitions": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
    "email": {
      "type": "object",
      "required": ["id", "from", "subject", "unlock"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "from": { "$ref": "#/definitions/slug" },
        "subject": { "type": "string", "minLength": 1, "maxLength": 160 },
        "body": { "type": "string", "minLength": 1 },
        "body_key": { "type": "string", "minLength": 1 },
        "unlock": {
          "type": "object",
          "properties": {
            "flag": { "$ref": "#/definitions/slug" },
            "event": { "type": "string", "pattern": "^[A-Z]{1,3}[0-9]{2}[a-z]?$" },
            "counter": { "$ref": "#/definitions/slug" },
            "min_count": { "type": "integer", "minimum": 0 },
            "title": { "type": "string" }
          },
          "additionalProperties": true
        },
        "duel_request": {
          "type": "object",
          "required": ["opponent", "deck"],
          "properties": {
            "opponent": { "$ref": "#/definitions/slug" },
            "deck": { "$ref": "#/definitions/slug" },
            "mode": {
              "type": "string",
              "enum": ["story", "free", "tutorial", "exam_timed", "exam_practical", "puzzle", "ante"]
            }
          },
          "additionalProperties": true
        },
        "attachments": {
          "type": "object",
          "properties": {
            "dp": { "type": "integer", "minimum": 0 },
            "cards": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1, "maximum": 1200 }
            },
            "packs": {
              "type": "array",
              "items": { "$ref": "#/definitions/slug" }
            }
          },
          "additionalProperties": true
        },
        "source": { "type": "string", "enum": ["canon", "original", "paraphrase", "fallback"] },
        "trace_id": { "type": "string" }
      },
      "anyOf": [
        { "required": ["body"] },
        { "required": ["body_key"] }
      ],
      "additionalProperties": true
    }
  }
}
